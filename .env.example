# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# --- Local LLMs (Ollama) ---
OLLAMA_HOST=http://localhost:11434
# Pin exact tags (name:tag, never untagged or :latest); `python -m shared.llm` prints the digests for the report.
DIAGNOSTIC_MODEL=medgemma:4b
COORDINATOR_MODEL=qwen3:8b
RECOMMENDATION_MODEL=qwen3:8b
BASELINE_MODEL=medgemma:4b
# Qwen3 thinking mode for the Qwen agents (slower, longer output). Never sent to MedGemma.
COORDINATOR_THINK=false
RECOMMENDATION_THINK=false
OLLAMA_KEEP_ALIVE=30m
LLM_TIMEOUT_S=180
LLM_TEMPERATURE=0.1
# Fixed seed for repeatable evaluation runs; leave empty for random sampling.
LLM_SEED=30018
# Context window in tokens. Ollama's default is small and silently cuts long prompts.
LLM_NUM_CTX=8192
LLM_JSON_RETRIES=1
LLM_HTTP_RETRIES=1

# --- Model service ---
MODEL_SERVICE_URL=http://localhost:8001
# stub = random scores, replay = precomputed predictions.json, live = run the checkpoint on local DICOMs
MODEL_MODE=stub
MODEL_CHECKPOINT=model_service/checkpoints/knee_v1.pt
REPLAY_PREDICTIONS=model_service/checkpoints/predictions.json
# live mode only: local copy of the Kaggle data (data/ is git-ignored)
LIVE_DATASET_ROOT=data/rsna-knee
LIVE_SERIES_CSV=data/rsna-knee/train_series.csv
LIVE_SPLIT_FOLDER=train_series
# auto = cuda if available, else cpu
MODEL_DEVICE=auto

# --- Coordinator ---
TOOL_TIMEOUT_S=180
MAX_RECHECK_ROUNDS=2
MAX_COORDINATOR_STEPS=12
REPORT_THRESHOLD=0.5
LOW_CONFIDENCE_THRESHOLD=0.6

# --- Backend (uvicorn backend.main:app --port 8000) ---
# auto = real Diagnostic Agent if agents/diagnostic_agent/agent.py defines DiagnosticAgent, else the interim adapter
DIAGNOSTIC_IMPL=auto
BACKEND_MAX_WORKERS=2
BACKEND_MAX_SESSIONS=200
# Sessions allowed to wait in the queue; beyond this POST /sessions and /baseline return 429
BACKEND_MAX_PENDING=20
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Recommendation Agent's tools ---
# Secret. Leave the placeholder (or empty) if you have no key; it is treated as unset.
TAVILY_API_KEY=your-tavily-api-key-here

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
# logs/app.jsonl rotates at this size; this many old files are kept
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5