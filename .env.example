# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# --- Local LLMs (Ollama) ---
OLLAMA_HOST=http://localhost:11434
# Pin exact tags; check with `ollama list` and record the digests for the report.
DIAGNOSTIC_MODEL=qwen3:8b
COORDINATOR_MODEL=qwen3:8b
RECOMMENDATION_MODEL=medgemma:4b
OLLAMA_KEEP_ALIVE=30m
LLM_TIMEOUT_S=180
LLM_TEMPERATURE=0.1
LLM_JSON_RETRIES=1

# --- Model service ---
MODEL_SERVICE_URL=http://localhost:8001
# stub = random scores, replay = precomputed predictions.json, live = run the checkpoint on local DICOMs
MODEL_MODE=stub
MODEL_CHECKPOINT=model_service/checkpoints/knee_v1.pt
REPLAY_PREDICTIONS=model_service/checkpoints/predictions.json

# --- Coordinator ---
TOOL_TIMEOUT_S=60
MAX_RECHECK_ROUNDS=2
MAX_COORDINATOR_STEPS=12
REPORT_THRESHOLD=0.5
LOW_CONFIDENCE_THRESHOLD=0.6

# --- Recommendation Agent's tools ---
TAVILY_API_KEY=your-tavily-api-key-here

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
